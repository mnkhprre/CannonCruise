# Doxyfile — CannonCruise dokümantasyon yapılandırması (Faz 5.3)
# Oluşturma: doxygen Doxyfile   (Çıktı: docs/html/)

PROJECT_NAME           = "CannonCruise"
PROJECT_NUMBER         = "tersine mühendislik (aktif geliştirme)"
PROJECT_BRIEF          = "CannonCruisePC yeniden inşa kaynak kodu"

# ---- Girdi ----
INPUT                  = code
FILE_PATTERNS          = *.h *.hpp *.cpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */build_*/*
EXCLUDE_SYMBOLS        =

# ---- Çıktı ----
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO

# ---- Çıktı biçimleri ----
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO

# ---- İçerik ----
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

# ---- Uyarılar ----
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_LOGFILE           = docs/doxygen-warnings.log

# ---- Grafik ----
HAVE_DOT               = NO
CLASS_GRAPH            = NO

# ---- Sınıflandırma ----
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
